
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=boilerplate
POSTGRES_PORT=5432

DATABASE_URL=postgresql://user:password@postgres:5432/boilerplate

# JWT
JWT_SECRET=secret
JWT_EXPIRES_IN=7d

# App
PORT=3000
NODE_ENV=development

# CORS (comma-separated origins, or * for all)
CORS_ORIGIN=*
